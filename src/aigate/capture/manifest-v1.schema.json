{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aigate.local/schemas/manifest-v1.json",
  "title": "AIGate session manifest",
  "description": "Metadata for one controlled capture session. Schema version 1.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_version",
    "session_id",
    "created_at_utc",
    "phase",
    "scenario_family",
    "repetition",
    "agent_provider",
    "agent_client",
    "client_version",
    "model_requested",
    "model_reported",
    "auth_mode",
    "netns",
    "host_ip",
    "ns_ip",
    "dns_resolver",
    "ipv6_disabled",
    "pcap_file",
    "snaplen",
    "bpf_filter",
    "started_at_utc",
    "ended_at_utc",
    "session_label",
    "labelling_rules_version",
    "valid",
    "contains_credentials",
    "publishable"
  ],
  "properties": {
    "manifest_version": { "const": 1 },
    "session_id": {
      "type": "string",
      "pattern": "^[0-9]{8}T[0-9]{6}Z-[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "created_at_utc": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
    "phase": { "enum": ["design", "pilot", "main"] },
    "operator": { "type": "string", "minLength": 1 },
    "scenario_family": { "enum": ["F1", "F2", "F3"] },
    "repetition": { "type": "integer", "minimum": 1, "maximum": 3 },
    "task_prompt_sha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
    "fixture_id": { "type": ["string", "null"] },
    "fixture_sha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
    "agent_provider": { "enum": ["openai", "anthropic", "deepseek"] },
    "agent_client": { "enum": ["codex-cli", "claude-code", "opencode"] },
    "client_version": { "type": "string", "minLength": 1 },
    "model_requested": { "type": "string", "minLength": 1 },
    "model_reported": { "type": ["string", "null"] },
    "auth_mode": {
      "enum": ["chatgpt_subscription", "oauth_subscription", "api_key", "unknown"]
    },
    "plan": { "type": ["string", "null"] },
    "host_os": { "type": "string" },
    "kernel": { "type": "string" },
    "arch": { "type": "string" },
    "python_version": { "type": "string" },
    "zeek_version": { "type": "string" },
    "tcpdump_version": { "type": "string" },
    "netns": { "type": "string", "pattern": "^aigate-[a-z0-9]{1,8}$" },
    "veth_host": { "type": "string", "pattern": "^veth-h-[a-z0-9]{1,8}$" },
    "veth_ns": { "type": "string", "pattern": "^veth-n-[a-z0-9]{1,8}$" },
    "host_ip": { "type": "string", "pattern": "^10\\.203\\.[0-9]{1,3}\\.1/30$" },
    "ns_ip": { "type": "string", "pattern": "^10\\.203\\.[0-9]{1,3}\\.2/30$" },
    "dns_resolver": { "type": "string", "minLength": 1 },
    "ipv6_disabled": { "type": "boolean" },
    "mtu": { "type": "integer", "minimum": 576, "maximum": 9000 },
    "pcap_file": { "type": "string", "pattern": "^data/raw/" },
    "pcap_sha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
    "snaplen": { "type": "integer", "minimum": 0 },
    "bpf_filter": { "type": "string" },
    "started_at_utc": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
    "ended_at_utc": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
    "packets": { "type": ["integer", "null"], "minimum": 0 },
    "bytes": { "type": ["integer", "null"], "minimum": 0 },
    "zeek_logdir": { "type": ["string", "null"] },
    "zeek_scripts": { "type": "string" },
    "logs_sha256": {
      "type": ["object", "null"],
      "additionalProperties": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
    },
    "exit_code": { "type": ["integer", "null"] },
    "duration_s": { "type": ["number", "null"], "minimum": 0 },
    "turns": { "type": ["integer", "null"], "minimum": 0 },
    "timeout_hit": { "type": "boolean" },
    "success": { "type": ["boolean", "null"] },
    "telemetry_disabled": { "enum": [true, false, "unknown"] },
    "autoupdate_disabled": { "enum": [true, false, "unknown"] },
    "standalone_mode": { "enum": [true, false, "not_applicable"] },
    "proxy_env_cleared": { "type": "boolean" },
    "session_label": {
      "enum": [
        "AGENT_ASSOCIATED_SESSION",
        "NON_AGENT_REFERENCE_SESSION",
        "AUTOMATION_NON_AI",
        "HUMAN_REFERENCE",
        "BACKGROUND_NOISE",
        "CLIENT_RUNTIME_IDLE"
      ]
    },
    "labelling_rules_version": { "type": "integer", "minimum": 1 },
    "flow_provenance_counts": {
      "type": "object",
      "propertyNames": {
        "enum": [
          "PROVIDER_API",
          "PROVIDER_AUX",
          "TOOL_LOCAL",
          "AGENT_TOOL_MCP",
          "AGENT_RUNTIME",
          "UNKNOWN_IN_SESSION"
        ]
      },
      "additionalProperties": { "type": "integer", "minimum": 0 }
    },
    "anomalies": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "valid": { "type": "boolean" },
    "invalidation_reason": { "type": ["string", "null"] },
    "contains_credentials": { "const": false },
    "publishable": { "type": "boolean" }
  }
}
